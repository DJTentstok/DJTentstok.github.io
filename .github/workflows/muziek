</div>

      <p>
        <a class="home-link" href="index.html">← TERUG NAAR DE HOMEPAGE</a>
      </p>
    </main>

    <footer>
      © 1998 DJ Tentstok · Muziek voor iedereen met een tentstok.
    </footer>
  </div>
  
  <script src="audio-player.js"></script>
</body>
</html>
