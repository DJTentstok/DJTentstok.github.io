<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Muziek, edits en radio-edits van DJ Tentstok.">
  <title>☆ Muziek — DJ Tentstok ☆</title>
  <style>
    :root {
      --aqua: #00ffff;
      --acid-yellow: #ffff00;
      --neon-pink: #ff00cc;
      --dark-blue: #07075e;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 18px 12px;
      color: #fff;
      font-family: "Arial Black", "Trebuchet MS", Arial, sans-serif;
      text-align: center;
      background-color: #060040;
      background-image: url("camo.png");
      background-size: 300px 300px;
    }

    .page {
      width: min(920px, 100%);
      margin: auto;
      background: #000080;
      border: 6px ridge var(--aqua);
      box-shadow: 0 0 0 5px var(--neon-pink), 0 0 26px var(--aqua);
    }

   .music-header {
  position: relative;
  z-index: 0;
  overflow: hidden;
  padding: 18px 10px 14px;
  text-align: center;

  border-bottom: 5px ridge #ffff00;

  background: linear-gradient(
    125deg,
    #18003f,
    #7000bd,
    #ff00cc,
    #ffe600,
    #7b00c7,
    #16003c
  );

  background-size: 350% 350%;
  animation: musicGradientMove 8s ease-in-out infinite;
}

/* Moving glowing light layer over the gradient. */
.music-header::before {
  position: absolute;
  z-index: -1;
  top: -90%;
  left: -35%;
  width: 170%;
  height: 280%;

  content: "";

  background:
    radial-gradient(circle, rgba(255, 255, 0, 0.8) 0%, transparent 20%),
    radial-gradient(circle, rgba(0, 255, 255, 0.55) 0%, transparent 22%),
    radial-gradient(circle, rgba(255, 0, 204, 0.7) 0%, transparent 24%);

  background-position: 8% 20%, 85% 70%, 45% 40%;
  background-size: 46% 46%, 50% 50%, 55% 55%;
  background-repeat: no-repeat;

  filter: blur(14px);
  opacity: 0.9;

  animation: musicGlowMove 6s ease-in-out infinite alternate;
}

.music-header h1 {
  position: relative;
  margin: 5px 0;

  color: #00ffff;
  font-family: Impact, "Arial Black", sans-serif;
  font-size: clamp(2.3rem, 8vw, 4.6rem);
  font-weight: normal;

  text-shadow:
    3px 3px 0 #000,
    6px 6px 0 #0000b8,
    0 0 12px #00ffff,
    0 0 24px #ff00cc;
}

.music-header marquee {
  position: relative;
  margin-top: 7px;

  color: #ffffff;
  font-family: Arial, sans-serif;
  font-weight: bold;

  text-shadow:
    2px 2px 0 #000,
    0 0 8px #ffff00;
}

.music-header .blink {
  position: relative;
}

@keyframes musicGradientMove {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

@keyframes musicGlowMove {
  0% {
    transform: rotate(-12deg) translate(-4%, -3%);
  }

  100% {
    transform: rotate(12deg) translate(5%, 4%);
  }
}

    .intro, .track {
      padding: 13px;
      border: 4px ridge #fff;
      background: var(--dark-blue);
    }

    .intro { margin-bottom: 14px; }

    h2 {
      margin: -3px -3px 12px;
      padding: 6px;
      color: #000;
      background: var(--aqua);
      border: 3px outset #fff;
      font-size: 1.2rem;
    }

    .track-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(265px, 1fr));
      gap: 14px;
    }

    .track {
      text-align: center;
    }

    .track h3 {
      margin: 0 0 5px;
      color: var(--acid-yellow);
      font-size: 1.2rem;
      text-shadow: 2px 2px #000;
    }

    .track p {
      margin: 6px 0 12px;
      font-size: 0.9rem;
    }

    audio {
      width: 100%;
      margin: 5px 0 10px;
    }

    .download-button, .home-link {
      display: inline-block;
      padding: 8px 11px;
      color: #000;
      background: var(--acid-yellow);
      border: 4px outset #fff;
      font-weight: bold;
      text-decoration: none;
    }

    .download-button:active, .home-link:active { border-style: inset; }
    .home-link { background: #ffb6e6; }

    .note {
      margin-top: 18px;
      padding: 10px;
      color: #000;
      background: #ffb6e6;
      border: 4px outset #fff;
      font-size: 0.88rem;
      text-align: left;
    }

    code {
      padding: 2px 4px;
      background: #222;
      color: #00ff00;
      font-family: "Courier New", monospace;
    }

    footer {
      padding: 12px;
      color: var(--aqua);
      background: #000;
      border-top: 4px ridge var(--neon-pink);
      font-family: "Courier New", monospace;
      font-size: 0.82rem;
    }

 .cool-player {
  padding: 10px;
  background: #000;
  border: 4px groove #00ffff;
}

.cool-player canvas {
  display: block;
  width: 100%;
  height: 140px;
  cursor: pointer;
  border: 2px inset #fff;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 9px;
}

.play-button,
.download-button {
  padding: 8px 9px;
  border: 4px outset #fff;
  cursor: pointer;
  font-weight: bold;
  font-family: Arial, sans-serif;
}

.play-button {
  color: #000;
  background: #ffff00;
}

.download-button {
  color: #fff;
  background: #ff00cc;
  text-decoration: none;
}

.time-display {
  margin-left: auto;
  color: #ffff00;
  font-family: "Courier New", monospace;
  font-size: 0.95rem;
  font-weight: bold;
  white-space: nowrap;
}
  </style>
</head>
<body>
  <div class="page">
 <header class="music-header">
